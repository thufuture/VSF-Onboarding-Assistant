#!/bin/bash
set -e
cat > /tmp/bootstrap.sh <<'BOOTSTRAP_SCRIPT'
${bootstrap_script}
BOOTSTRAP_SCRIPT
DEPLOY_USER=ubuntu VSF_ROOT=/opt/vsf-onlyoffice bash /tmp/bootstrap.sh

install -d -m 755 -o ubuntu -g ubuntu /opt/vsf-onlyoffice
cd /opt/vsf-onlyoffice

# Khóa JWT chỉ đọc được bởi root và docker (không đưa vào compose).
umask 077
cat > onlyoffice.env <<'ENVFILE'
JWT_ENABLED=true
JWT_SECRET=${jwt_secret}
JWT_HEADER=Authorization
JWT_IN_BODY=false
ENVFILE
umask 022

cat > Caddyfile <<'CADDYFILE'
${public_host} {
	encode zstd gzip
	# Không đặt X-Frame-Options: trang web (Vercel) nhúng trình soạn thảo bằng iframe.
	reverse_proxy documentserver:80
}
CADDYFILE

cat > compose.yml <<'COMPOSE'
name: vsf-onlyoffice
services:
  documentserver:
    image: ${image}
    restart: unless-stopped
    env_file: onlyoffice.env
    volumes:
      - ds-data:/var/www/onlyoffice/Data
      - ds-log:/var/log/onlyoffice
      - ds-lib:/var/lib/onlyoffice
      - ds-db:/var/lib/postgresql
    healthcheck:
      test: ["CMD", "curl", "-fs", "http://localhost/healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 120s
  caddy:
    image: caddy:2
    restart: unless-stopped
    depends_on:
      - documentserver
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
volumes:
  ds-data:
  ds-log:
  ds-lib:
  ds-db:
  caddy-data:
  caddy-config:
COMPOSE

docker compose up -d
