# Sao chép thành .env (đã bị .gitignore). KHÔNG commit giá trị thật.
APP_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Trỏ tới cổng host của docker-compose (POSTGRES_HOST_PORT, mặc định 5434).
DATABASE_URL=postgresql+asyncpg://vsf:vsf@localhost:5434/vsf

# docker-compose cục bộ (tất cả tùy chọn)
PARADEDB_TAG=v0.25.4-pg16
POSTGRES_HOST_PORT=5434
BACKEND_HOST_PORT=8000
# Frontend dev (next dev) chuyển /api/* tới backend này; production do Caddy đảm nhiệm.
API_UPSTREAM_URL=http://127.0.0.1:8000
# Khóa ký cookie phiên `vsf_session`. Ngoài production để trống thì tự sinh khóa ngẫu nhiên (đăng nhập mất khi
# khởi động lại). Production BẮT BUỘC: tối thiểu 32 ký tự, ngẫu nhiên (ví dụ `openssl rand -base64 48`).
SESSION_SECRET=
SESSION_TTL_SECONDS=1800
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# LLM: DeepSeek qua giao diện tương thích OpenAI. Không hard-code tên model.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Embedding: BGE-M3 trên Modal (đổi tên từ BGE_M3_* của Ralion)
EMBEDDING_PROVIDER=modal-bge-m3
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=

# Lưu file tài liệu gốc (2-B): "cloudinary" đẩy lên Cloudinary, DB chỉ lưu URL (storage_key);
# "local" (mặc định, an toàn cho dev/CI không cần tài khoản ngoài) lưu vào STORAGE_PATH trên đĩa.
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CHAT_HISTORY_MESSAGES=6
RETENTION_CHAT_DAYS=90
RETENTION_TELEMETRY_DAYS=180
RETENTION_DEBUG_DAYS=30
CONTENT_GAP_MIN_USERS=2

# Chỉ dùng khi sinh lại bộ seed và muốn chép PDF luật công khai (ngăn cách bằng ; trên Windows)
VSF_LAB_DIRS=
