# Sao chép thành .env (đã bị .gitignore). KHÔNG commit giá trị thật.
APP_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Trỏ tới cổng host của docker-compose (POSTGRES_HOST_PORT, mặc định 5434).
DATABASE_URL=postgresql+asyncpg://vsf:vsf@localhost:5434/vsf

# docker-compose cục bộ (tất cả tùy chọn)
PARADEDB_TAG=v0.25.4-pg16
POSTGRES_HOST_PORT=5434
BACKEND_HOST_PORT=8000
# Frontend dev (next dev) chuyển /api/* tới backend này; production do Caddy đảm nhiệm.
API_UPSTREAM_URL=http://127.0.0.1:8000
# Khóa ký cookie phiên `vsf_session`. Ngoài production để trống thì tự sinh khóa ngẫu nhiên (đăng nhập mất khi
# khởi động lại). Production BẮT BUỘC: tối thiểu 32 ký tự, ngẫu nhiên (ví dụ `openssl rand -base64 48`).
SESSION_SECRET=
SESSION_TTL_SECONDS=1800
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# LLM: DeepSeek qua giao diện tương thích OpenAI. Không hard-code tên model.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Embedding: BGE-M3 trên Modal (đổi tên từ BGE_M3_* của Ralion)
EMBEDDING_PROVIDER=modal-bge-m3
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=

# Lưu file tài liệu gốc (2-B): "cloudinary" đẩy lên Cloudinary, DB chỉ lưu URL (storage_key);
# "local" (mặc định, an toàn cho dev/CI không cần tài khoản ngoài) lưu vào STORAGE_PATH trên đĩa.
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CHAT_HISTORY_MESSAGES=6
RETENTION_CHAT_DAYS=90
RETENTION_TELEMETRY_DAYS=180
RETENTION_DEBUG_DAYS=30
CONTENT_GAP_MIN_USERS=2

# Chỉ dùng khi sinh lại bộ seed và muốn chép PDF luật công khai (ngăn cách bằng ; trên Windows)
VSF_LAB_DIRS=

# --- Tối ưu truy hồi và trả lời của Viga (benchmark 11/10/2026; xem docs/value/optimize-chatviga/BAO-CAO-TONG-HOP-BENCHMARK-VIGA.md) ---
# Hồ sơ truy hồi: legacy (như cũ) hoặc optimized (RRF k=10, BM25 : vector = 0,1 : 1, giữ 5 mục mỗi câu hỏi con).
# Cắt 5 mục chỉ an toàn cùng RRF tối ưu, nên bật bằng hồ sơ thay vì đặt riêng RETRIEVAL_MAX_SECTIONS.
RETRIEVAL_PROFILE=legacy
# Router v2: phân biệt xã giao / ngoài phạm vi / chèn lệnh (trả OUT_OF_SCOPE thay vì INFO).
VIGA_ROUTER_V2=false
# Suy luận ở bước trả lời: always (như cũ), off (nhanh hơn 2 đến 5 giây, Faithfulness có xu hướng thấp hơn), adaptive (không giảm P95).
ANSWER_THINKING_MODE=always
# Số chỗ dành cho mục đứng đầu của BM25 trong các mục giữ lại (0 = tắt). Đo ngày 12/10: không có lợi với giữ 5 mục, làm tụt bộ ngữ nghĩa ~4,6 điểm; chỉ cân nhắc khi giữ rất ít mục.
RETRIEVAL_BM25_RESERVE=0

# --- LLM dự phòng (Claude Haiku qua OpenRouter): chỉ dùng khi DeepSeek lỗi hạ tầng (hết giờ, mạng, 429, 5xx, khóa hỏng). Mặc định tắt. ---
# Cần khóa OpenRouter CÓ SỐ DƯ (khóa không số dư báo lỗi 402). Việc nền (sinh task) mặc định không dùng dự phòng.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_MODEL=anthropic/claude-haiku-5.5
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_TIMEOUT_SECONDS=30
LLM_FALLBACK_MAX_OUTPUT_TOKENS=4000
LLM_FALLBACK_FOR_BACKGROUND=false
LLM_FALLBACK_FAILURE_THRESHOLD=3
LLM_FALLBACK_COOLDOWN_SECONDS=60
