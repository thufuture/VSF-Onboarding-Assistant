# Sao chép thành /opt/vsf-aws/env/backend.env trên máy chủ AWS. Không commit giá trị thật.
# Khớp backend/src/config.py — chỉ liệt kê biến thật sự dùng ở production (Phase 2/4 đã thêm nhiều biến
# mới so với bản backend.env.example gốc của VPS; cập nhật cả hai khi thêm setting mới).
APP_ENV=production
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
# Host "db" là tên service trong mạng Docker; mật khẩu phải khớp POSTGRES_PASSWORD trong compose.env.
DATABASE_URL=postgresql+asyncpg://vsf:<mat-khau>@db:5432/vsf

# Bắt buộc ở production (Settings từ chối khởi động nếu thiếu/yếu — xem config.py _session_secret_rules).
SESSION_SECRET=<chuoi-ngau-nhien-manh-openssl-rand-hex-32>

# Embedding BGE-M3. Mặc định production tự host cùng máy (service `embedder`, xem deploy/aws/embedder/README.md); dùng Modal thì
# đặt EMBEDDING_ENDPOINT=<url-modal-embed> và khóa của Modal.
EMBEDDING_PROVIDER=modal-bge-m3
EMBEDDING_ENDPOINT=http://embedder:8080
EMBEDDING_API_KEY=<khoa-embedder-trung-embedder.env>

# Lưu file gốc tài liệu trên Cloudinary (không dùng local ở production — ổ đĩa EC2 không bền qua redeploy).
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# LLM (DeepSeek).
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=<khoa-deepseek>

# Langfuse (tuỳ chọn): theo dõi từng bước gọi LLM/embedding, độ trễ, token, chi phí. Tắt an toàn nếu để false hoặc thiếu khóa.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=<public-key>
LANGFUSE_SECRET_KEY=<secret-key>
LANGFUSE_HOST=https://cloud.langfuse.com
# Gắn nhãn môi trường cho trace để lọc production khỏi dev trong cùng một dự án Langfuse (SDK tự đọc biến này; chữ thường,
# không bắt đầu bằng "langfuse"). Không đặt thì mọi trace mang nhãn "default" và không phân biệt được máy nào.
LANGFUSE_TRACING_ENVIRONMENT=production
# Gửi NỘI DUNG (câu hỏi của nhân viên, đoạn tài liệu, câu trả lời) lên Langfuse Cloud, dịch vụ bên thứ ba. Mặc định false theo
# nguyên tắc INV8 (không đưa dữ liệu nội bộ ra ngoài): chỉ có số liệu (độ dài, số lượng, token, chi phí, thời gian), cột
# Input/Output sẽ trống. Bật = true khi chấp nhận gửi nội dung; mỗi chuỗi cắt ở LANGFUSE_CONTENT_MAX_CHARS ký tự.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_CONTENT_MAX_CHARS=4000
