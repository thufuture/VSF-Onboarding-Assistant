# Sao chép thành /opt/vsf-aws/env/backend.env trên máy chủ AWS. Không commit giá trị thật.
# Khớp backend/src/config.py — chỉ liệt kê biến thật sự dùng ở production (Phase 2/4 đã thêm nhiều biến
# mới so với bản backend.env.example gốc của VPS; cập nhật cả hai khi thêm setting mới).
APP_ENV=production
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
# Host "db" là tên service trong mạng Docker; mật khẩu phải khớp POSTGRES_PASSWORD trong compose.env.
DATABASE_URL=postgresql+asyncpg://vsf:<mat-khau>@db:5432/vsf

# Bắt buộc ở production (Settings từ chối khởi động nếu thiếu/yếu — xem config.py _session_secret_rules).
SESSION_SECRET=<chuoi-ngau-nhien-manh-openssl-rand-hex-32>

# Embedding BGE-M3 (Modal) — dùng lại endpoint đã có sẵn từ dev, không cấu hình lại từ đầu.
EMBEDDING_PROVIDER=modal-bge-m3
EMBEDDING_ENDPOINT=<url-modal-embed>
EMBEDDING_API_KEY=<khoa-modal>

# Lưu file gốc tài liệu trên Cloudinary (không dùng local ở production — ổ đĩa EC2 không bền qua redeploy).
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# LLM (DeepSeek).
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=<khoa-deepseek>

# Langfuse (tuỳ chọn — tắt an toàn nếu để false/thiếu khoá, xem langfuse_tracer.py).
# LƯU Ý: gói `langfuse` CHƯA có trong backend/requirements.txt (đã thấy trong log Docker dev:
# "ModuleNotFoundError: No module named 'langfuse'") — bật LANGFUSE_ENABLED=true bây giờ vẫn an toàn
# (tự tắt theo dõi, không crash) nhưng KHÔNG thật sự theo dõi được gì cho tới khi thêm `langfuse` vào
# requirements.txt và build lại image. Mặc định để false cho tới khi làm việc đó.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=<public-key>
LANGFUSE_SECRET_KEY=<secret-key>
LANGFUSE_HOST=https://cloud.langfuse.com
